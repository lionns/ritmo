---
import Grain from "../components/atoms/Grain.astro";
import Wordmark from "../components/atoms/Wordmark.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** design-handoff.md § Header: the mono label opposite the wordmark, naming where you are. */
  context: string;
  /** Optional wider wording from `md` up, where the same label has room to say more. */
  contextWide?: string;
  /** Let a form-heavy route grow past the desktop viewport and use the document scrollbar. */
  pageScroll?: boolean;
}

const { title, description, context, contextWide, pageScroll = false } = Astro.props;
---

<!doctype html>
<html class="min-h-full min-w-80 bg-bg font-sans text-ink [text-rendering:optimizeLegibility]" lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090A" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F2F0EA" media="(prefers-color-scheme: light)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="/fonts/fontshare.css" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Martian+Mono:wght@300;400&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="m-0 min-h-screen min-h-dvh overflow-x-hidden bg-bg font-sans text-ink selection:bg-accent selection:text-accent-ink">
    <div
      class:list={[
        "relative isolate min-h-screen min-h-dvh px-5 pt-8 pb-6 md:px-16 md:py-11 xl:py-[clamp(24px,4dvh,44px)]",
        !pageScroll && "xl:h-dvh xl:min-h-0",
      ]}
    >
      <div
        class="pointer-events-none fixed -z-30 h-[76vh] blur-[86px] [background:radial-gradient(ellipse_at_50%_50%,rgba(var(--page-glow),0.5)_0%,rgba(var(--page-glow),0.12)_36%,transparent_72%)] -inset-x-[15vw] -bottom-[34vh]"
        aria-hidden="true"
      ></div>
      <Grain />
      <div
        class:list={[
          "relative z-[2] mx-auto flex min-h-[calc(100dvh-56px)] w-[min(100%,1312px)] flex-col md:min-h-[calc(100dvh-88px)]",
          !pageScroll && "xl:h-full xl:min-h-0",
        ]}
      >
        <header class="mb-11 flex items-baseline justify-between gap-4 md:mb-16 xl:mb-[clamp(24px,4dvh,64px)] xl:shrink-0">
          <Wordmark />
          <p class="m-0 text-right font-mono text-[8px] leading-[1.4] font-normal tracking-[0.22em] text-dim uppercase md:text-[9px]" data-header-context>
            {contextWide === undefined ? context : (
              <>
                <span class="md:hidden">{context}</span>
                <span class="hidden md:inline">{contextWide}</span>
              </>
            )}
          </p>
        </header>
        <slot />
        <footer class="mt-auto flex items-center justify-between gap-3 pt-[34px] xl:shrink-0 xl:pt-[clamp(12px,2dvh,34px)]">
          <p class="m-0 font-mono text-[8px] leading-[1.4] font-normal tracking-[0.22em] text-dim uppercase md:text-[9px]">
            Un registro que acompaña
          </p>
          <nav class="flex flex-wrap gap-[18px]" aria-label="Navegación secundaria">
            <a
              class="inline-flex min-h-[58px] items-center text-sm font-medium text-dim underline-offset-[5px] transition-colors duration-[120ms] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none md:min-h-14"
              href="/archivo">Archivo</a
            >
            <a
              class="inline-flex min-h-[58px] items-center text-sm font-medium text-dim underline-offset-[5px] transition-colors duration-[120ms] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none md:min-h-14"
              href="/ajustes">Ajustes</a
            >
          </nav>
        </footer>
      </div>
    </div>
  </body>
</html>
