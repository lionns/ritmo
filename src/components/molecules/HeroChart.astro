---
import type { PortfolioEntry } from "../../../contracts/portfolio.ts";
import {
  buildChartDays,
  CHART_RISE_DURATION_MS,
  CHART_STAGGER_MS,
  DESKTOP_CHART_DAYS,
  MOBILE_CHART_DAYS,
  type ChartDay,
} from "./hero-chart.ts";

interface Props {
  entries: PortfolioEntry[];
}

const { entries } = Astro.props;
const desktopDays = buildChartDays(entries, new Date(), DESKTOP_CHART_DAYS);
const mobileDays = desktopDays.slice(-MOBILE_CHART_DAYS);
const baseline = 126;
const dayFormatter = new Intl.DateTimeFormat("es", {
  day: "numeric",
  month: "short",
  timeZone: "UTC",
});

function accessibleLabel(day: ChartDay): string {
  const label = dayFormatter.format(new Date(`${day.date}T00:00:00.000Z`));
  if (day.state === "empty") return `${label}: nada registrado`;
  if (day.state === "untimed") return `${label}: ${day.entries} entradas, sin minutos`;
  return `${label}: ${day.entries} entradas, ${day.minutes} minutos`;
}
---

<figure
  class="mx-auto w-[min(100%,1440px)] text-faint-text"
  data-hero-chart
  data-rise-duration={CHART_RISE_DURATION_MS}
  style={`--rise-duration:${CHART_RISE_DURATION_MS}ms;--rise-stagger:${CHART_STAGGER_MS}ms`}
>
  <svg
    class="hidden h-[clamp(168px,24vw,300px)] w-full overflow-visible md:block"
    viewBox="0 0 560 136"
    role="img"
    aria-label="Actividad de los últimos 28 días; la altura representa minutos registrados"
    preserveAspectRatio="none"
  >
    {desktopDays.map((day, index) => (
      <g class="chart-day" transform={`translate(${index * 20 + 6} 0)`}>
        <title>{accessibleLabel(day)}</title>
        <rect
          class:list={["chart-bar", day.state === "empty" ? "fill-faint-text" : "fill-accent"]}
          data-chart-mark
          data-today-mark={index === desktopDays.length - 1 ? "true" : undefined}
          data-state={day.state}
          x="0"
          y={baseline - day.height}
          width="8"
          height={day.height}
          rx="4"
          style={`--bar-index:${index + 1}`}
        />
      </g>
    ))}
  </svg>
  <svg
    class="block h-[clamp(168px,24vw,300px)] w-full overflow-visible md:hidden"
    viewBox="0 0 280 136"
    role="img"
    aria-label="Actividad de los últimos 14 días; la altura representa minutos registrados"
    preserveAspectRatio="none"
  >
    {mobileDays.map((day, index) => (
      <g class="chart-day" transform={`translate(${index * 20 + 6} 0)`}>
        <title>{accessibleLabel(day)}</title>
        <rect
          class:list={["chart-bar", day.state === "empty" ? "fill-faint-text" : "fill-accent"]}
          data-chart-mark
          data-today-mark={index === mobileDays.length - 1 ? "true" : undefined}
          data-state={day.state}
          x="0"
          y={baseline - day.height}
          width="8"
          height={day.height}
          rx="4"
          style={`--bar-index:${index + 1}`}
        />
      </g>
    ))}
  </svg>
  <figcaption class="flex min-h-7 flex-wrap items-center gap-x-3.5 gap-y-[9px] px-5 font-mono text-[8px] leading-[1.5] tracking-[0.16em] text-faint-text uppercase md:px-16 md:text-[9px]">
    <span class="hidden md:block">28 días · altura = minutos registrados</span>
    <span class="md:hidden">14 días · minutos</span>
    <span class="inline-flex items-center gap-[5px]"><i class="inline-block size-2 rounded-full border border-current bg-transparent"></i>Nada</span>
    <span class="inline-flex items-center gap-[5px]"><i class="inline-block size-2 rounded-full border border-current bg-accent"></i>Sin minutos</span>
    <span class="inline-flex items-center gap-[5px]"><i class="inline-block size-2 rounded-full border border-current bg-accent shadow-[0_-5px_0_-2px_var(--page-accent)]"></i>Con minutos</span>
  </figcaption>
</figure>

<style>
  .chart-bar {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: rise var(--rise-duration) cubic-bezier(0.16, 0.9, 0.24, 1) both;
    animation-delay: calc(var(--bar-index) * var(--rise-stagger));
  }

  @media (prefers-reduced-motion: reduce) {
    .chart-bar {
      animation: none;
    }
  }
</style>
