---
import type { PortfolioEntry } from "../../../contracts/portfolio.ts";
import {
  buildChartDays,
  CHART_RISE_DURATION_MS,
  CHART_STAGGER_MS,
  DESKTOP_CHART_DAYS,
  MOBILE_CHART_DAYS,
  type ChartDay,
} from "./hero-chart.ts";

interface Props {
  entries: PortfolioEntry[];
}

const { entries } = Astro.props;
const desktopDays = buildChartDays(entries, new Date(), DESKTOP_CHART_DAYS);
const mobileDays = desktopDays.slice(-MOBILE_CHART_DAYS);
const baseline = 126;
const dayFormatter = new Intl.DateTimeFormat("es", {
  day: "numeric",
  month: "short",
  timeZone: "UTC",
});

function accessibleLabel(day: ChartDay): string {
  const label = dayFormatter.format(new Date(`${day.date}T00:00:00.000Z`));
  if (day.state === "empty") return `${label}: nada registrado`;
  if (day.state === "untimed") return `${label}: ${day.entries} entradas, sin minutos`;
  return `${label}: ${day.entries} entradas, ${day.minutes} minutos`;
}
---

<figure
  class="hero-chart"
  data-hero-chart
  data-rise-duration={CHART_RISE_DURATION_MS}
  style={`--rise-duration:${CHART_RISE_DURATION_MS}ms;--rise-stagger:${CHART_STAGGER_MS}ms`}
>
  <svg
    class="chart-svg chart-desktop"
    viewBox="0 0 560 136"
    role="img"
    aria-label="Actividad de los últimos 28 días; la altura representa minutos registrados"
    preserveAspectRatio="none"
  >
    {desktopDays.map((day, index) => (
      <g class="chart-day" transform={`translate(${index * 20 + 6} 0)`}>
        <title>{accessibleLabel(day)}</title>
        <rect
          class:list={["chart-bar", `chart-bar--${day.state}`]}
          data-chart-mark
          data-today-mark={index === desktopDays.length - 1 ? "true" : undefined}
          data-state={day.state}
          x="0"
          y={baseline - day.height}
          width="8"
          height={day.height}
          rx="4"
          style={`--bar-index:${index + 1}`}
        />
      </g>
    ))}
  </svg>
  <svg
    class="chart-svg chart-mobile"
    viewBox="0 0 280 136"
    role="img"
    aria-label="Actividad de los últimos 14 días; la altura representa minutos registrados"
    preserveAspectRatio="none"
  >
    {mobileDays.map((day, index) => (
      <g class="chart-day" transform={`translate(${index * 20 + 6} 0)`}>
        <title>{accessibleLabel(day)}</title>
        <rect
          class:list={["chart-bar", `chart-bar--${day.state}`]}
          data-chart-mark
          data-today-mark={index === mobileDays.length - 1 ? "true" : undefined}
          data-state={day.state}
          x="0"
          y={baseline - day.height}
          width="8"
          height={day.height}
          rx="4"
          style={`--bar-index:${index + 1}`}
        />
      </g>
    ))}
  </svg>
  <figcaption class="chart-caption">
    <span class="chart-caption-desktop">28 días · altura = minutos registrados</span>
    <span class="chart-caption-mobile">14 días · minutos</span>
    <span class="chart-key"><i class="key-empty"></i>Nada</span>
    <span class="chart-key"><i class="key-untimed"></i>Sin minutos</span>
    <span class="chart-key"><i class="key-timed"></i>Con minutos</span>
  </figcaption>
</figure>

<style>
  .hero-chart {
    width: min(100%, 1440px);
    margin: 0 auto;
    color: var(--page-faint-text);
  }

  .chart-svg {
    width: 100%;
    height: clamp(168px, 24vw, 300px);
    display: block;
    overflow: visible;
  }

  .chart-desktop,
  .chart-caption-desktop {
    display: none;
  }

  .chart-bar {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: rise var(--rise-duration) cubic-bezier(0.16, 0.9, 0.24, 1) both;
    animation-delay: calc(var(--bar-index) * var(--rise-stagger));
  }

  .chart-bar--empty {
    fill: var(--page-faint-text);
  }

  .chart-bar--untimed,
  .chart-bar--timed {
    fill: var(--page-accent);
  }

  .chart-caption {
    min-height: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px 14px;
    padding: 0 20px;
    color: var(--page-faint-text);
    font-family: "Martian Mono", ui-monospace, monospace;
    font-size: 8px;
    letter-spacing: 0.16em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .chart-key {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .chart-key i {
    width: 8px;
    height: 8px;
    display: inline-block;
    border-radius: 50%;
    border: 1px solid currentColor;
  }

  .key-empty {
    background: transparent;
  }

  .key-untimed {
    background: var(--page-accent);
  }

  .key-timed {
    background: var(--page-accent);
    box-shadow: 0 -5px 0 -2px var(--page-accent);
  }

  @keyframes rise {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  @media (min-width: 768px) {
    .chart-mobile,
    .chart-caption-mobile {
      display: none;
    }

    .chart-desktop,
    .chart-caption-desktop {
      display: block;
    }

    .chart-caption {
      padding: 0 64px;
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chart-bar {
      animation: none;
    }
  }
</style>
