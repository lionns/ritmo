---
import type { PortfolioProject } from "../../../contracts/portfolio.ts";
import { countProgressMarks, markedForToday, readAsSentence } from "../../lib/project-row.ts";
import StepList from "../organisms/StepList.astro";

interface Props {
  project: PortfolioProject;
  kind: "progress" | "outstanding" | "shelved";
  today: string;
}

const { project, kind, today } = Astro.props;
const latestEntry = project.recentEntries[0];
const progressMarks = project.state === "active" ? countProgressMarks(project.progressSincePlan) : 0;
const logHref = `/registrar?project=${encodeURIComponent(project.id)}`;
const areaName = project.area.name;
// design-handoff.md § The Project Row: today's steps read as language, never as a checklist —
// an unchecked box on the landing surface is a debt symbol (NFR-7, D-024).
const todaySteps = markedForToday(project.openSteps, today);
const emptyLine = project.openSteps.length === 0
  ? "Escribe los próximos pasos cuando los sepas."
  : "Elige lo de hoy cuando lo sepas.";
---

{
  project.state === "shelved" ? (
    <div class="project-card min-h-[58px] border-b border-hair py-3.5 last:border-b-0 md:min-h-14 md:py-4" data-project-kind={kind}>
      <h3 class="m-0 text-[17px] leading-[1.15] font-semibold tracking-[-0.02em] text-ink md:text-xl">{project.title}</h3>
      <p class="mt-2 mb-0 text-sm leading-[1.45] text-dim md:text-[15px]">Archivado · {areaName}</p>
      {latestEntry && <p class="mt-1.5 mb-0 text-sm leading-[1.45] text-dim md:text-[15px]"><span class="text-faint-text">Último:</span> {latestEntry.what}</p>}
    </div>
  ) : (
    <article class="border-b border-hair last:border-b-0" data-project-kind={kind}>
      <a
        class="project-card block min-h-[58px] pt-3.5 pb-3.5 no-underline hover:[&_.project-line]:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14 md:pt-4 md:pb-4"
        href={logHref}
      >
        <span class="project-marks flex items-center gap-2.5" aria-hidden="true">
          {
            Array.from({ length: progressMarks }, (_unused, index) => (
              <span class="mark-progress block size-[11px] rounded-full bg-accent md:size-3" data-mark-index={index} />
            ))
          }
          {project.openSteps.length > 0 && (
            <span class="mark-open block size-[11px] rounded-full border-[1.5px] border-faint md:size-3" />
          )}
          <span class="mark-goal ml-[5px] block size-2 rotate-45 bg-faint md:size-[9px]" />
        </span>
        <h3 class="project-title mt-2 mb-0 text-[17px] leading-[1.15] font-semibold tracking-[-0.02em] text-ink md:text-xl">{project.title}</h3>
        {
          todaySteps.length === 0 ? (
            <span class="project-line mt-2 block min-h-[26px] text-sm leading-[1.45] text-dim transition-colors duration-[120ms] motion-reduce:transition-none md:text-[15px]">{emptyLine}</span>
          ) : (
            todaySteps.map((step) => (
              <span class="project-line mt-2 block min-h-[26px] text-sm leading-[1.45] text-dim transition-colors duration-[120ms] motion-reduce:transition-none md:text-[15px]">{readAsSentence(step)}</span>
            ))
          )
        }
        {
          latestEntry && (
            <span class="project-latest mt-1.5 block text-sm leading-[1.45] text-dim md:text-[15px]">
              <span class="text-faint-text">Último:</span> {latestEntry.what}
            </span>
          )
        }
      </a>
      <StepList project={project} today={today} />
    </article>
  )
}

<style>
  /* design-handoff.md § Responsive Behavior: density may remove empty space, not reading
     structure. Only the outer padding contracts — the 8px between the marks, the title and the
     sentence is the row's hierarchy and is never touched. */
  @media (min-width: 75rem) and (max-height: 75rem) {
    .project-card {
      padding-top: 12px;
      padding-bottom: 12px;
    }
  }
</style>
