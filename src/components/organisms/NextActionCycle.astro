---
import type { PortfolioProject } from "../../../contracts/portfolio.ts";
import NextActionFields from "../molecules/NextActionFields.astro";

interface Props {
  project: PortfolioProject;
}

const { project } = Astro.props;
const formPrefix = `next-action-${project.id}`;
---

<details class="border-t border-hair" data-action-cycle>
  <summary class="flex min-h-[58px] cursor-pointer list-none items-center justify-between gap-4 py-3 text-sm font-medium text-dim marker:content-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14">
    <span>{project.nextAction === null ? "Escribir la próxima acción" : "Cerrar y escribir la siguiente"}</span>
    <span class="font-mono text-[13px] text-faint-text" data-disclosure-marker aria-hidden="true">+</span>
  </summary>
  <form class="pb-5" data-next-action-form novalidate>
    <input type="hidden" name="projectId" value={project.id} />
    {project.nextAction && <input type="hidden" name="currentActionId" value={project.nextAction.id} />}
    <NextActionFields idPrefix={formPrefix} />
    <button class="mt-5 inline-flex min-h-[58px] w-full items-center justify-center rounded-[29px] border-0 bg-accent px-7 text-[17px] font-semibold text-accent-ink transition-[filter] duration-[120ms] hover:brightness-[1.06] active:brightness-90 disabled:cursor-wait disabled:saturate-[0.35] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14 md:rounded-[28px] md:text-base" type="submit">
      {project.nextAction === null ? "Guardar acción" : "Cerrar y continuar"}
    </button>
    <p class="mt-3 min-h-[42px] text-sm leading-normal text-dim" data-next-action-status data-form-status aria-live="polite"></p>
  </form>
</details>

<script>
  import {
    bindFieldErrorClearing,
    clearFieldErrors,
    fieldIssueFromServer,
    fieldNames,
    firstFieldIssue,
    setFormStatus,
    showFieldIssue,
  } from "../../lib/form-errors.ts";

  document.querySelectorAll<HTMLFormElement>("[data-next-action-form]").forEach((form) => {
    bindFieldErrorClearing(form);
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const projectId = form.elements.namedItem("projectId");
      const currentActionId = form.elements.namedItem("currentActionId");
      const trigger = form.elements.namedItem("trigger");
      const act = form.elements.namedItem("act");
      const obstacle = form.elements.namedItem("obstacle");
      const estimate = form.elements.namedItem("estimateMinutes");
      const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
      const status = form.querySelector<HTMLElement>("[data-next-action-status]");
      if (
        !(projectId instanceof HTMLInputElement) ||
        !(trigger instanceof HTMLInputElement) ||
        !(act instanceof HTMLInputElement) ||
        !(obstacle instanceof HTMLInputElement) ||
        !(estimate instanceof HTMLInputElement)
      ) return;
      const issue = firstFieldIssue([
        { name: "trigger", value: trigger.value, requiredMessage: "Escribe el disparador." },
        { name: "act", value: act.value, requiredMessage: "Escribe la acción." },
        {
          name: "estimateMinutes",
          value: estimate.value,
          positiveIntegerMessage: "Escribe minutos enteros mayores que cero.",
        },
      ]);
      if (issue !== null) {
        showFieldIssue(form, issue);
        setFormStatus(status, "", "idle");
        return;
      }
      clearFieldErrors(form);
      if (button !== null) button.disabled = true;
      setFormStatus(status, "Guardando…", "loading");
      try {
        const body: Record<string, string | number> = {
          projectId: projectId.value,
          trigger: trigger.value,
          act: act.value,
        };
        if (currentActionId instanceof HTMLInputElement) {
          body.currentActionId = currentActionId.value;
        }
        if (obstacle.value.trim() !== "") body.obstacle = obstacle.value;
        if (estimate.value !== "") body.estimateMinutes = Number(estimate.value);
        const response = await fetch("/api/next-actions", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const result: unknown = await response.json();
        if (!response.ok) {
          const serverIssue = fieldIssueFromServer(readError(result), fieldNames(form));
          if (serverIssue !== null) {
            showFieldIssue(form, serverIssue);
            setFormStatus(status, "", "idle");
          } else {
            setFormStatus(status, "No se pudo guardar la acción. Recarga la página e inténtalo otra vez.", "error");
          }
          return;
        }
        setFormStatus(status, currentActionId instanceof HTMLInputElement
          ? "Acción cerrada. La siguiente queda abierta."
          : "Próxima acción guardada.", "success");
        window.setTimeout(() => window.location.reload(), 500);
      } catch {
        setFormStatus(status, "No se pudo conectar. Revisa la conexión e inténtalo otra vez.", "error");
      } finally {
        if (button !== null) button.disabled = false;
      }
    });
  });

  function readError(body: unknown): string {
    return typeof body === "object" && body !== null && "error" in body && typeof body.error === "string"
      ? body.error
      : "No se pudo guardar la acción";
  }
</script>
