---
import type { SettingsResponse } from "../../../contracts/capture.ts";
import FieldError from "../atoms/FieldError.astro";
import ProjectCapture from "./ProjectCapture.astro";

interface Props {
  settings: SettingsResponse;
}

const { settings } = Astro.props;
const cappedAreaIds = new Set(
  settings.areas.filter(({ countsAgainstCap }) => countsAgainstCap).map(({ id }) => id),
);
const activeCount = settings.projects.filter(
  ({ areaId, state }) => state === "active" && cappedAreaIds.has(areaId),
).length;
const areaCountLabel = `${settings.areas.length} ${settings.areas.length === 1 ? "área" : "áreas"}`;
---

<section class="glass-panel p-[22px] md:p-7" aria-labelledby="areas-heading">
  <h2 id="areas-heading" class="font-mono text-[8px] leading-[1.4] tracking-[0.22em] text-dim uppercase md:text-[9px]">Áreas</h2>
  <form class="mt-4" data-area-form novalidate>
    <div class="grid gap-4 xl:grid-cols-2 xl:items-end" data-area-fields>
      <div>
        <label class="mb-2 block text-sm font-medium text-dim" for="area-name">Nombre</label>
        <input class="min-h-[58px] w-full rounded-field border border-glass-border bg-[color-mix(in_srgb,var(--page-bg)_72%,transparent)] px-4 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14" id="area-name" name="name" required aria-describedby="area-name-error" data-field-control="name" />
        <FieldError id="area-name-error" field="name" />
      </div>
      <label class="flex min-h-[58px] items-center gap-3 rounded-field border border-glass-border px-4 text-sm text-ink md:min-h-14">
        <input class="size-5 accent-accent" name="countsAgainstCap" type="checkbox" />
        Cuenta dentro del límite
      </label>
    </div>
    <p class="mt-3 text-sm leading-normal text-dim">Déjalo sin marcar para el trabajo fijo: sus proyectos no compiten por este límite.</p>
    <button class="mt-5 min-h-[58px] w-full rounded-[29px] bg-accent px-7 text-[17px] font-semibold text-accent-ink transition-[filter] hover:brightness-[1.06] active:brightness-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14" type="submit">Crear área</button>
    <p class="mt-3 min-h-[24px] text-sm leading-normal text-dim" data-area-status data-form-status aria-live="polite"></p>
  </form>
  <form class="mt-5 border-t border-hair pt-5" data-cap-form novalidate>
    <label class="mb-2 block text-sm font-medium text-dim" for="active-cap">Proyectos en una semana mala</label>
    <div class="grid items-start gap-3 md:grid-cols-[1fr_auto]">
      <div>
        <input class="min-h-[58px] w-full rounded-field border border-glass-border bg-[color-mix(in_srgb,var(--page-bg)_72%,transparent)] px-4 font-mono text-xl font-light text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14" id="active-cap" name="activeCap" type="number" min="1" step="1" value={settings.activeCap} required aria-describedby="active-cap-error" data-field-control="activeCap" />
        <FieldError id="active-cap-error" field="activeCap" />
      </div>
      <button class="min-h-[58px] rounded-[29px] border border-glass-border px-6 text-base font-semibold text-ink transition-[filter] hover:brightness-[1.06] active:brightness-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14" type="submit">Guardar</button>
    </div>
    <p class="mt-3 min-h-[24px] text-sm leading-normal text-dim" data-cap-status data-form-status aria-live="polite"></p>
  </form>
  {
    settings.areas.length > 0 && (
      <details class="mt-5 border-t border-hair">
        <summary class="flex min-h-[58px] cursor-pointer list-none items-center justify-between gap-4 py-3 text-sm font-medium text-dim marker:content-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14">
          <span>{areaCountLabel}</span>
          <span class="font-mono text-[13px] text-faint-text" data-disclosure-marker aria-hidden="true">+</span>
        </summary>
        <ul class="m-0 list-none border-t border-hair p-0">
          {settings.areas.map((area) => (
            <li class="flex min-h-14 items-center justify-between gap-4 border-b border-hair py-3 text-sm">
              <span class="font-medium text-ink">{area.name}</span>
              <span class="text-right text-dim">{area.countsAgainstCap ? "Dentro del límite" : "Fuera del límite"}</span>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</section>

<section class="glass-panel p-[22px] md:p-7" aria-labelledby="projects-heading">
  <h2 id="projects-heading" class="font-mono text-[8px] leading-[1.4] tracking-[0.22em] text-dim uppercase md:text-[9px]">Proyectos</h2>
  <ProjectCapture
    areas={settings.areas}
    activeCount={activeCount}
    activeCap={settings.activeCap}
  />
</section>

<script>
  import {
    bindFieldErrorClearing,
    clearFieldErrors,
    fieldIssueFromServer,
    fieldNames,
    firstFieldIssue,
    setFormStatus,
    showFieldIssue,
  } from "../../lib/form-errors.ts";

  const capForm = document.querySelector<HTMLFormElement>("[data-cap-form]");
  const capStatus = document.querySelector<HTMLElement>("[data-cap-status]");
  if (capForm !== null) bindFieldErrorClearing(capForm);
  capForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const field = capForm.elements.namedItem("activeCap");
    if (!(field instanceof HTMLInputElement)) return;
    const issue = firstFieldIssue([{
      name: "activeCap",
      value: field.value,
      requiredMessage: "Escribe cuántos proyectos caben en una semana mala.",
      positiveIntegerMessage: "Escribe un número entero mayor que cero.",
    }]);
    if (issue !== null) {
      showFieldIssue(capForm, issue);
      setFormStatus(capStatus, "", "idle");
      return;
    }
    clearFieldErrors(capForm);
    await submit(capForm, "/api/settings", "PATCH", { activeCap: Number(field.value) }, capStatus, "Límite guardado.");
  });

  const areaForm = document.querySelector<HTMLFormElement>("[data-area-form]");
  const areaStatus = document.querySelector<HTMLElement>("[data-area-status]");
  if (areaForm !== null) bindFieldErrorClearing(areaForm);
  areaForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const name = areaForm.elements.namedItem("name");
    const counts = areaForm.elements.namedItem("countsAgainstCap");
    if (!(name instanceof HTMLInputElement) || !(counts instanceof HTMLInputElement)) return;
    const issue = firstFieldIssue([{
      name: "name",
      value: name.value,
      requiredMessage: "Escribe el nombre del área.",
    }]);
    if (issue !== null) {
      showFieldIssue(areaForm, issue);
      setFormStatus(areaStatus, "", "idle");
      return;
    }
    clearFieldErrors(areaForm);
    const saved = await submit(areaForm, "/api/areas", "POST", { name: name.value, countsAgainstCap: counts.checked }, areaStatus, "Área creada.");
    if (saved) window.location.reload();
  });

  async function submit(form: HTMLFormElement, url: string, method: string, body: object, status: HTMLElement | null, success: string): Promise<boolean> {
    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
    if (button !== null) button.disabled = true;
    setFormStatus(status, "Guardando…", "loading");
    try {
      const response = await fetch(url, { method, headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
      const result: unknown = await response.json();
      if (!response.ok) {
        const rawError = typeof result === "object" && result !== null && "error" in result && typeof result.error === "string" ? result.error : "";
        const serverIssue = fieldIssueFromServer(rawError, fieldNames(form));
        if (serverIssue !== null) {
          showFieldIssue(form, serverIssue);
          setFormStatus(status, "", "idle");
        } else {
          setFormStatus(status, "No se pudo guardar. Recarga la página e inténtalo otra vez.", "error");
        }
        return false;
      }
      setFormStatus(status, success, "success");
      return true;
    } catch {
      setFormStatus(status, "No se pudo conectar. Revisa la conexión e inténtalo otra vez.", "error");
      return false;
    } finally {
      if (button !== null) button.disabled = false;
    }
  }
</script>
