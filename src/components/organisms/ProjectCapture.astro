---
import type { PortfolioArea } from "../../../contracts/portfolio.ts";
import FieldError from "../atoms/FieldError.astro";
import ListboxField from "../molecules/ListboxField.astro";
import NextActionFields from "../molecules/NextActionFields.astro";

interface Props {
  areas: PortfolioArea[];
  activeCount: number;
  activeCap: number;
}

const { areas, activeCount, activeCap } = Astro.props;
---

<section class="mt-[34px] border-t border-hair pt-6" id="nuevo-proyecto" aria-labelledby="new-project-heading">
  <h2 id="new-project-heading" class="font-mono text-[8px] leading-[1.4] font-normal tracking-[0.22em] text-dim uppercase md:text-[9px]">Nuevo proyecto</h2>
  <p class="mt-3 font-mono text-[9px] leading-normal tracking-[0.08em] text-faint-text uppercase">
    {activeCount} de {activeCap} activos en áreas con límite
  </p>
  {
    areas.length === 0 ? (
      <p class="mt-4 text-sm leading-normal text-dim">
        Crea un área en <a class="font-medium text-ink underline-offset-4" href="/ajustes">Ajustes</a> antes del primer proyecto.
      </p>
    ) : (
      <form class="mt-4" data-project-form novalidate>
        <div class="grid gap-4 xl:grid-cols-2" data-project-fields>
          <div>
            <label class="mb-2 block text-sm font-medium text-dim" for="project-title">Nombre</label>
            <input class="min-h-[58px] w-full rounded-field border border-glass-border bg-[color-mix(in_srgb,var(--page-bg)_72%,transparent)] px-4 text-base text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14" id="project-title" name="title" required aria-describedby="project-title-error" data-field-control="title" />
            <FieldError id="project-title-error" field="title" />
          </div>
          <ListboxField
            id="project-area"
            name="areaId"
            label="Área"
            options={areas.map(({ id, name }) => ({ value: id, label: name }))}
          />
        </div>
        <section class="mt-5 border-t border-hair pt-5" aria-labelledby="first-action-heading">
          <h3 id="first-action-heading" class="mb-4 font-mono text-[8px] leading-[1.4] font-normal tracking-[0.22em] text-dim uppercase md:text-[9px]">Primera acción</h3>
          <NextActionFields idPrefix="project-action" paired />
        </section>
        <button class="mt-5 inline-flex min-h-[58px] w-full items-center justify-center rounded-[29px] border-0 bg-accent px-7 text-[17px] font-semibold text-accent-ink transition-[filter] duration-[120ms] hover:brightness-[1.06] active:brightness-90 disabled:cursor-wait disabled:saturate-[0.35] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14 md:rounded-[28px] md:text-base" type="submit">Crear proyecto</button>
        <p class="mt-3 min-h-[42px] text-sm leading-normal text-dim" data-project-status data-form-status aria-live="polite"></p>
      </form>
    )
  }
</section>

<script>
  import type { CreateProjectResponse } from "../../../contracts/capture.ts";
  import {
    bindFieldErrorClearing,
    clearFieldErrors,
    fieldIssueFromServer,
    fieldNames,
    firstFieldIssue,
    setFormStatus,
    showFieldIssue,
  } from "../../lib/form-errors.ts";

  const form = document.querySelector<HTMLFormElement>("[data-project-form]");
  const status = document.querySelector<HTMLElement>("[data-project-status]");
  if (form !== null) bindFieldErrorClearing(form);
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const title = form.elements.namedItem("title");
    const areaId = form.elements.namedItem("areaId");
    const trigger = form.elements.namedItem("trigger");
    const act = form.elements.namedItem("act");
    const obstacle = form.elements.namedItem("obstacle");
    const estimate = form.elements.namedItem("estimateMinutes");
    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
    if (
      !(title instanceof HTMLInputElement) ||
      !(areaId instanceof HTMLInputElement) ||
      !(trigger instanceof HTMLInputElement) ||
      !(act instanceof HTMLInputElement) ||
      !(obstacle instanceof HTMLInputElement) ||
      !(estimate instanceof HTMLInputElement)
    ) return;
    const issue = firstFieldIssue([
      { name: "title", value: title.value, requiredMessage: "Escribe el nombre del proyecto." },
      { name: "areaId", value: areaId.value, requiredMessage: "Elige un área." },
      { name: "trigger", value: trigger.value, requiredMessage: "Escribe el disparador." },
      { name: "act", value: act.value, requiredMessage: "Escribe la acción." },
      {
        name: "estimateMinutes",
        value: estimate.value,
        positiveIntegerMessage: "Escribe minutos enteros mayores que cero.",
      },
    ]);
    if (issue !== null) {
      showFieldIssue(form, issue);
      setFormStatus(status, "", "idle");
      return;
    }
    clearFieldErrors(form);
    if (button !== null) button.disabled = true;
    setFormStatus(status, "Guardando…", "loading");
    try {
      const response = await fetch("/api/projects", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          title: title.value,
          areaId: areaId.value,
          trigger: trigger.value,
          act: act.value,
          ...(obstacle.value.trim() === "" ? {} : { obstacle: obstacle.value }),
          ...(estimate.value === "" ? {} : { estimateMinutes: Number(estimate.value) }),
        }),
      });
      const body: unknown = await response.json();
      if (!response.ok) {
        const serverIssue = fieldIssueFromServer(readError(body), fieldNames(form));
        if (serverIssue !== null) {
          showFieldIssue(form, serverIssue);
          setFormStatus(status, "", "idle");
        } else {
          setFormStatus(status, "No se pudo crear el proyecto. Recarga la página e inténtalo otra vez.", "error");
        }
        return;
      }
      const result = body as CreateProjectResponse;
      setFormStatus(status, result.countsAgainstCap
        ? `${result.project.state === "active" ? "Activo" : "Archivado"}. ${result.activeCount} de ${result.activeCap} proyectos en áreas con límite.`
        : "Activo. Esta área no cuenta dentro del límite.", "success");
      window.setTimeout(() => window.location.reload(), 700);
    } catch {
      setFormStatus(status, "No se pudo conectar. Revisa la conexión e inténtalo otra vez.", "error");
    } finally {
      if (button !== null) button.disabled = false;
    }
  });

  function readError(body: unknown): string {
    return typeof body === "object" && body !== null && "error" in body && typeof body.error === "string" ? body.error : "No se pudo crear el proyecto";
  }
</script>
