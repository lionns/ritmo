---
import type { PortfolioProject } from "../../../contracts/portfolio.ts";
import { EFFORT_MINUTE_OPTIONS } from "../../lib/entry-form.ts";
import { readAsSentence } from "../../lib/project-row.ts";
import FieldError from "../atoms/FieldError.astro";
import ListboxField from "../molecules/ListboxField.astro";

interface Props {
  projects: PortfolioProject[];
  selectedProject?: PortfolioProject;
}

const { projects, selectedProject } = Astro.props;
const initialProject = selectedProject?.id ?? projects[0]?.id;
---

<form class="glass-panel p-[22px] md:p-7" data-entry-form novalidate>
  {
    selectedProject && (
      <div class="mb-[22px]">
        <h2 class="text-[19px] leading-tight font-semibold tracking-[-0.02em] text-ink md:text-xl">
          {selectedProject.title}
        </h2>
        <input type="hidden" name="projectId" value={selectedProject.id} />
        {selectedProject.nextAction && (
          <div class="mt-5">
            <p class="font-mono text-[8px] leading-[1.4] tracking-[0.2em] text-dim uppercase">
              Próxima acción
            </p>
            <p class="mt-2 text-[15px] leading-[1.45] text-dim">
              {readAsSentence(selectedProject.nextAction)}
            </p>
          </div>
        )}
      </div>
    )
  }
  <div>
    <label class="mb-[9px] block font-mono text-[8px] leading-[1.4] tracking-[0.2em] text-dim uppercase" for="entry-what">Una línea sobre lo que moviste</label>
    <textarea
      id="entry-what"
      name="what"
      rows="3"
      required
      autofocus
      aria-describedby="entry-what-error"
      data-field-control="what"
      placeholder="Ej. Dejé lista la estructura del primer capítulo"
      class="min-h-[132px] w-full resize-y rounded-field border border-glass-border bg-[color-mix(in_srgb,var(--page-bg)_72%,transparent)] p-4 text-base leading-[1.45] text-ink placeholder:text-faint-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-[150px]"
    ></textarea>
    <FieldError id="entry-what-error" field="what" />
  </div>
  {
    !selectedProject && (
      <ListboxField
        class="mt-[22px]"
        id="entry-project"
        name="projectId"
        label="Proyecto"
        labelKind="eyebrow"
        options={projects.map(({ id, title }) => ({ value: id, label: title }))}
        selectedValue={initialProject}
      />
    )
  }
  <fieldset class="mt-[22px]">
    <legend class="mb-[9px] font-mono text-[8px] leading-[1.4] tracking-[0.2em] text-dim uppercase">
      MINUTOS · OPCIONAL
    </legend>
    <div class="grid grid-cols-4 gap-2" data-effort-options>
      {
        EFFORT_MINUTE_OPTIONS.map((minutes) => (
          <button
            class="min-h-[58px] cursor-pointer rounded-field border border-glass-border bg-[color-mix(in_srgb,var(--page-bg)_72%,transparent)] px-2 font-mono text-sm font-light text-ink transition-[filter] duration-[120ms] hover:brightness-[1.06] active:brightness-90 aria-pressed:border-accent aria-pressed:font-normal aria-pressed:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none md:min-h-14"
            type="button"
            data-effort-minutes={minutes}
            aria-label={`${minutes} minutos`}
            aria-pressed="false"
          >
            {minutes}
          </button>
        ))
      }
    </div>
  </fieldset>
  <button
    class="mt-6 inline-flex min-h-[58px] w-full cursor-pointer items-center justify-center rounded-[29px] border-0 bg-accent px-7 text-[17px] font-semibold text-accent-ink transition-[filter] duration-[120ms] hover:brightness-[1.06] active:brightness-90 disabled:cursor-wait disabled:saturate-[0.35] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none md:min-h-14 md:w-auto md:min-w-[218px] md:rounded-[28px] md:text-base"
    type="submit"
    disabled={projects.length === 0}
  >
    Guardar entrada
  </button>
  <p class="mx-0 mt-3 min-h-[42px] text-sm leading-normal text-dim" data-entry-status data-form-status aria-live="polite"></p>
</form>

<script>
  import {
    buildEntryRequest,
    confirmOptimisticChartMark,
    isEffortMinuteOption,
    toggleEffortMinutes,
    type EffortMinuteOption,
  } from "../../lib/entry-form.ts";
  import {
    bindFieldErrorClearing,
    clearFieldErrors,
    fieldIssueFromServer,
    fieldNames,
    firstFieldIssue,
    setFormStatus,
    showFieldIssue,
  } from "../../lib/form-errors.ts";

  const form = document.querySelector<HTMLFormElement>("[data-entry-form]");
  const status = document.querySelector<HTMLElement>("[data-entry-status]");
  const effortButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-effort-minutes]")];
  let effortMinutes: EffortMinuteOption | undefined;
  if (form !== null) bindFieldErrorClearing(form);

  effortButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const pressed = Number(button.dataset.effortMinutes);
      if (!isEffortMinuteOption(pressed)) return;
      effortMinutes = toggleEffortMinutes(effortMinutes, pressed);
      syncEffortButtons();
    });
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const what = form.elements.namedItem("what");
    const projectId = form.elements.namedItem("projectId");
    if (
      !(what instanceof HTMLTextAreaElement) ||
      !(projectId instanceof HTMLInputElement)
    ) return;

    const issue = firstFieldIssue([
      {
        name: "what",
        value: what.value,
        requiredMessage: "Escribe una línea sobre lo que moviste.",
      },
      {
        name: "projectId",
        value: projectId.value,
        requiredMessage: "Elige un proyecto.",
      },
    ]);
    if (issue !== null) {
      showFieldIssue(form, issue);
      setFormStatus(status, "", "idle");
      return;
    }
    clearFieldErrors(form);

    if (submit !== null) submit.disabled = true;
    setFormStatus(status, "Guardando…", "loading");
    const submittedEffortMinutes = effortMinutes;

    try {
      const response = await fetch("/api/entries", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(buildEntryRequest(projectId.value, what.value, effortMinutes)),
      });
      const body: unknown = await response.json();
      if (!response.ok) {
        const rawError =
          typeof body === "object" && body !== null && "error" in body && typeof body.error === "string"
            ? body.error
            : "";
        const serverIssue = fieldIssueFromServer(rawError, fieldNames(form));
        if (serverIssue !== null) {
          showFieldIssue(form, serverIssue);
          setFormStatus(status, "", "idle");
        } else {
          setFormStatus(status, "No se pudo guardar la entrada. Recarga la página e inténtalo otra vez.", "error");
        }
        return;
      }

      what.value = "";
      effortMinutes = undefined;
      syncEffortButtons();
      setFormStatus(status, "Entrada guardada.", "success");
      growTodayMarks(submittedEffortMinutes);
      what.focus();
    } catch {
      setFormStatus(status, "No se pudo conectar. Revisa la conexión e inténtalo otra vez.", "error");
    } finally {
      if (submit !== null) submit.disabled = false;
    }
  });

  function syncEffortButtons(): void {
    effortButtons.forEach((button) => {
      button.setAttribute(
        "aria-pressed",
        String(Number(button.dataset.effortMinutes) === effortMinutes),
      );
    });
  }

  function growTodayMarks(loggedMinutes: EffortMinuteOption | undefined): void {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const chart = document.querySelector<HTMLElement>("[data-hero-chart]");
    const duration = Number(chart?.dataset.riseDuration ?? 220);
    document.querySelectorAll<SVGRectElement>("[data-today-mark]").forEach((mark) => {
      const baseline = 126;
      const currentHeight = Number(mark.getAttribute("height") ?? 9);
      const currentState = mark.dataset.state;
      if (currentState !== "empty" && currentState !== "untimed" && currentState !== "timed") return;
      const confirmed = confirmOptimisticChartMark(currentHeight, currentState, loggedMinutes);
      mark.setAttribute("height", String(confirmed.height));
      mark.setAttribute("y", String(baseline - confirmed.height));
      mark.setAttribute("data-state", confirmed.state);
      mark.classList.remove("fill-faint-text");
      mark.classList.add("fill-accent");
      if (!reducedMotion) {
        mark.animate(
          [{ transform: "scaleY(0)" }, { transform: "scaleY(1)" }],
          { duration, easing: "cubic-bezier(.16,.9,.24,1)" },
        );
      }
    });
  }
</script>
