---
import type { PortfolioProject } from "../../../contracts/portfolio.ts";

interface Props {
  projects: PortfolioProject[];
  selectedProjectId?: string;
}

const { projects, selectedProjectId } = Astro.props;
const initialProject = projects.some(({ id }) => id === selectedProjectId)
  ? selectedProjectId
  : projects[0]?.id;
---

<form class="glass-panel p-[22px] md:p-7" data-entry-form>
  <div>
    <label class="mb-[9px] block font-mono text-[8px] leading-[1.4] tracking-[0.2em] text-dim uppercase" for="entry-what">Una línea sobre lo que moviste</label>
    <textarea
      id="entry-what"
      name="what"
      rows="3"
      required
      autofocus
      placeholder="Ej. Dejé lista la estructura del primer capítulo"
      class="min-h-[132px] w-full resize-y rounded-field border border-glass-border bg-[color-mix(in_srgb,var(--page-bg)_72%,transparent)] p-4 text-base leading-[1.45] text-ink placeholder:text-faint-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-[150px]"
    ></textarea>
  </div>
  <div class="mt-[22px]">
    <label class="mb-[9px] block font-mono text-[8px] leading-[1.4] tracking-[0.2em] text-dim uppercase" for="entry-project">Proyecto</label>
    <select
      class="min-h-[58px] w-full rounded-field border border-glass-border bg-[color-mix(in_srgb,var(--page-bg)_72%,transparent)] p-4 text-base leading-[1.45] text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14"
      id="entry-project"
      name="projectId"
      required
    >
      {projects.map((project) => (
        <option value={project.id} selected={project.id === initialProject}>{project.title}</option>
      ))}
    </select>
  </div>
  <button
    class="mt-6 inline-flex min-h-[58px] w-full cursor-pointer items-center justify-center rounded-[29px] border-0 bg-accent px-7 text-[17px] font-semibold text-accent-ink transition-[filter] duration-[120ms] hover:brightness-[1.06] active:brightness-90 disabled:cursor-wait disabled:saturate-[0.35] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none md:min-h-14 md:w-auto md:min-w-[218px] md:rounded-[28px] md:text-base"
    type="submit"
    disabled={projects.length === 0}
  >
    Guardar entrada
  </button>
  <p class="mx-0 mt-3 min-h-[42px] text-sm leading-normal text-dim" data-form-status aria-live="polite"></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-entry-form]");
  const status = document.querySelector<HTMLElement>("[data-form-status]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const what = form.elements.namedItem("what");
    const projectId = form.elements.namedItem("projectId");
    if (!(what instanceof HTMLTextAreaElement) || !(projectId instanceof HTMLSelectElement)) return;

    if (submit !== null) submit.disabled = true;
    if (status !== null) status.textContent = "Guardando…";

    try {
      const response = await fetch("/api/entries", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ projectId: projectId.value, what: what.value }),
      });
      const body: unknown = await response.json();
      if (!response.ok) {
        const message =
          typeof body === "object" && body !== null && "error" in body && typeof body.error === "string"
            ? body.error
            : "No se pudo guardar la entrada";
        throw new Error(message);
      }

      what.value = "";
      if (status !== null) status.textContent = "Entrada guardada.";
      growTodayMarks();
      what.focus();
    } catch (error) {
      if (status !== null) {
        const detail = error instanceof Error ? error.message : "No se pudo guardar la entrada";
        status.textContent = `${detail}. Revisa la conexión e inténtalo otra vez.`;
      }
    } finally {
      if (submit !== null) submit.disabled = false;
    }
  });

  function growTodayMarks(): void {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const chart = document.querySelector<HTMLElement>("[data-hero-chart]");
    const duration = Number(chart?.dataset.riseDuration ?? 220);
    document.querySelectorAll<SVGRectElement>("[data-today-mark]").forEach((mark) => {
      const baseline = 126;
      const currentHeight = Number(mark.getAttribute("height") ?? 9);
      const nextHeight = Math.max(12, currentHeight);
      mark.setAttribute("height", String(nextHeight));
      mark.setAttribute("y", String(baseline - nextHeight));
      mark.setAttribute("data-state", "untimed");
      mark.classList.remove("fill-faint-text");
      mark.classList.add("fill-accent");
      if (!reducedMotion) {
        mark.animate(
          [{ transform: "scaleY(0)" }, { transform: "scaleY(1)" }],
          { duration, easing: "cubic-bezier(.16,.9,.24,1)" },
        );
      }
    });
  }
</script>
