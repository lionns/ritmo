---
import type { PortfolioArea, PortfolioProject } from "../../../contracts/portfolio.ts";
import ProjectCard from "../molecules/ProjectCard.astro";
import ProjectCapture from "./ProjectCapture.astro";

interface Props {
  progress: PortfolioProject[];
  outstanding: PortfolioProject[];
  shelved: PortfolioProject[];
  areas: PortfolioArea[];
  activeCount: number;
  activeCap: number;
}

const { progress, outstanding, shelved, areas, activeCount, activeCap } = Astro.props;
---

<section
  class="portfolio-panel glass-panel p-[22px] md:px-7 md:py-6 xl:max-h-full xl:overflow-y-auto xl:overscroll-contain"
  aria-labelledby="portfolio-heading"
>
  <h2 id="portfolio-heading" class="m-0 font-mono text-[8px] leading-[1.4] font-normal tracking-[0.22em] text-dim uppercase md:text-[9px]">En movimiento</h2>
  {
    progress.length === 0 ? (
      <p class="mt-5 mb-1 text-sm leading-normal text-dim">Aún no hay proyectos en movimiento.</p>
    ) : (
      <div class="portfolio-progress mt-1.5">
        {progress.map((project) => <ProjectCard project={project} kind="progress" />)}
      </div>
    )
  }
  {
    outstanding.length > 0 && (
      <section class="portfolio-outstanding mt-[34px] border-t border-hair pt-6" aria-labelledby="outstanding-heading">
        <h2 id="outstanding-heading" class="m-0 font-mono text-[8px] leading-[1.4] font-normal tracking-[0.22em] text-dim uppercase md:text-[9px]">Para cuando vuelvas</h2>
        <div class="mt-1.5">
          {outstanding.map((project) => <ProjectCard project={project} kind="outstanding" />)}
        </div>
      </section>
    )
  }
  {
    shelved.length > 0 && (
      <section class="portfolio-shelved mt-[34px] border-t border-hair pt-6" aria-labelledby="shelved-heading">
        <h2 id="shelved-heading" class="m-0 font-mono text-[8px] leading-[1.4] font-normal tracking-[0.22em] text-dim uppercase md:text-[9px]">Archivados</h2>
        <div class="mt-1.5">
          {shelved.map((project) => <ProjectCard project={project} kind="shelved" />)}
        </div>
      </section>
    )
  }
  <ProjectCapture areas={areas} activeCount={activeCount} activeCap={activeCap} />
</section>

<style>
  @media (min-width: 75rem) {
    .portfolio-panel {
      scrollbar-color: color-mix(in srgb, var(--page-dim) 72%, transparent) transparent;
      scrollbar-width: thin;
    }
  }

  @media (min-width: 75rem) and (max-height: 75rem) {
    .portfolio-panel {
      padding-block: 16px;
    }

    .portfolio-progress {
      margin-top: 2px;
    }

    .portfolio-outstanding {
      margin-top: 16px;
      padding-top: 16px;
    }

    .portfolio-shelved {
      margin-top: 16px;
      padding-top: 16px;
    }
  }
</style>
