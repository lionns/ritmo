---
import type { ProjectDetailResponse } from "../../../contracts/project.ts";
import StepFields from "../molecules/StepFields.astro";
import { readAsSentence } from "../../lib/project-row.ts";

interface Props {
  project: ProjectDetailResponse;
}

const { project } = Astro.props;
const finished = project.finishedAt !== null;
const shelved = project.state === "shelved";
const formPrefix = `step-${project.id}`;
const dayLabel = (moment: string) =>
  new Date(moment).toLocaleDateString("es", { day: "2-digit", month: "short" });
// D-025 and brief.md § Constraints: no count of steps or entries, nothing red, no congratulation.
---

<section class="glass-panel flex min-h-0 flex-col p-[22px] md:px-7 md:py-6" aria-labelledby="steps-heading">
  {
    finished ? (
      <>
        <h2 id="steps-heading" class="m-0 font-mono text-[8px] leading-[1.4] font-normal tracking-[0.22em] text-dim uppercase md:text-[9px]">Terminado</h2>
        <p class="mt-4 mb-0 text-sm leading-normal text-dim md:text-[15px]">
          Lo diste por terminado. Sigue entero aquí y en el archivo.
        </p>
      </>
    ) : (
      <>
        <h2 id="steps-heading" class="m-0 font-mono text-[8px] leading-[1.4] font-normal tracking-[0.22em] text-dim uppercase md:text-[9px]">Pasos</h2>
        {shelved && (
          <p class="mt-4 mb-0 text-sm leading-normal text-dim md:text-[15px]">
            Archivado. Sus pasos siguen aquí; para escribir o marcar alguno, actívalo.
          </p>
        )}
        {
          project.openSteps.length === 0 ? (
            <p class="mt-4 mb-0 text-sm leading-normal text-dim md:text-[15px]">
              Escribe el próximo tramo cuando lo sepas. Sólo lo que sigue, no el proyecto entero.
            </p>
          ) : (
            <ul class="m-0 list-none p-0">
              {project.openSteps.map((step) => (
                <li class="flex items-start justify-between gap-3 border-b border-hair py-3 last:border-b-0">
                  <span class="min-w-0">
                    <span class="block text-sm leading-[1.45] text-dim md:text-[15px]">{readAsSentence(step)}</span>
                    {step.estimateMinutes !== null && (
                      <span class="mt-1 block font-mono text-[11px] leading-normal tracking-[0.06em] text-dim">
                        {step.estimateMinutes} min estimados
                      </span>
                    )}
                  </span>
                  <span class="flex shrink-0 items-center gap-2">
                    {!shelved && (
                    <button
                      class:list={[
                        "min-h-[34px] rounded-full border px-3 text-[13px] font-medium transition-[color,border-color] duration-[120ms] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
                        step.markedFor === project.today
                          ? "border-accent text-accent"
                          : "border-glass-border text-dim hover:text-ink",
                      ]}
                      type="button"
                      data-step-mark={step.id}
                      data-step-marked={step.markedFor === project.today ? "true" : "false"}
                    >
                      {step.markedFor === project.today ? "Quitar de hoy" : "Hoy"}
                    </button>
                    )}
                    {!shelved && (
                    <button
                      class="min-h-[34px] rounded-full border border-glass-border px-3 text-[13px] font-medium text-dim transition-[color,border-color] duration-[120ms] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                      type="button"
                      data-step-done={step.id}
                    >
                      Hecho
                    </button>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          )
        }

        {!shelved && (
        <form class="mt-4" data-step-form novalidate>
          <input type="hidden" name="projectId" value={project.id} />
          <StepFields idPrefix={formPrefix} paired calibration={project.calibration} />
          <button class="mt-4 inline-flex min-h-[58px] w-full items-center justify-center rounded-[29px] border-0 bg-accent px-7 text-[17px] font-semibold text-accent-ink transition-[filter] duration-[120ms] hover:brightness-[1.06] active:brightness-90 disabled:cursor-wait disabled:saturate-[0.35] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14 md:rounded-[28px] md:text-base" type="submit">
            Guardar paso
          </button>
          <p class="mt-3 min-h-[42px] text-sm leading-normal text-dim" data-step-status data-form-status aria-live="polite"></p>
        </form>
        )}
      </>
    )
  }

  <h2 class="mt-6 font-mono text-[8px] leading-[1.4] font-normal tracking-[0.22em] text-dim uppercase md:text-[9px]">Historial</h2>
  {project.history.length === 0 && (
    <p class="mt-4 mb-0 text-sm leading-normal text-dim md:text-[15px]" data-history-empty>Nada registrado todavía.</p>
  )}
  {/* Always present, even empty, so a saved entry has a list to land in without a reload. */}
  <ul class="m-0 list-none p-0" data-history>
    {project.history.map((item) => (
          <li class="flex items-start gap-3.5 border-b border-hair py-3 last:border-b-0">
            <span class="shrink-0 pt-0.5 font-mono text-[12px] whitespace-nowrap text-dim">{dayLabel(item.at)}</span>
            {/*
              The filled circle carries the whole distinction: a closed step has one, a written
              entry has none. It is the language the portfolio row already speaks — filled means
              done — and it is why there is no checkbox here (`D-024`, `NFR-7`).
            */}
            <span class:list={["mt-1.5 w-3 shrink-0", item.kind === "step" && "size-3 rounded-full bg-accent"]} aria-hidden="true" />
            {
              item.kind === "step" ? (
                <span class="min-w-0 grow">
                  <span class="block text-sm leading-[1.45] text-ink md:text-[15px]">{item.title}</span>
                  {(item.estimateMinutes !== null || item.effortMinutes > 0) && (
                    <span class="mt-1 block font-mono text-[11px] leading-normal tracking-[0.06em] text-dim">
                      {item.estimateMinutes !== null && `estimaste ${item.estimateMinutes}`}
                      {item.estimateMinutes !== null && item.effortMinutes > 0 && " · "}
                      {item.effortMinutes > 0 && `registraste ${item.effortMinutes}`}
                    </span>
                  )}
                </span>
              ) : (
                <>
                  <span class="grow text-sm leading-[1.45] text-ink md:text-[15px]">{item.what}</span>
                  {item.effortMinutes !== null && (
                    <span class="shrink-0 pt-0.5 font-mono text-[12px] text-dim">{item.effortMinutes} min</span>
                  )}
                </>
              )
            }
          </li>
        ))}
  </ul>

  {
  }
</section>

<script define:vars={{ today: project.today }}>
  window.__ritmoToday = today;
</script>
<script>
  import {
    bindFieldErrorClearing,
    clearFieldErrors,
    fieldIssueFromServer,
    fieldNames,
    firstFieldIssue,
    setFormStatus,
    showFieldIssue,
  } from "../../lib/form-errors.ts";

  const today = (window as unknown as { __ritmoToday: string }).__ritmoToday;

  /*
    A native <details> closes on its own for nothing: Escape and an outside pointer are ours to
    add, the same two the custom listbox already answers. And it flips upward when there is no
    room below, so the menu is reachable near the bottom of a phone.
  */
  const menu = document.querySelector<HTMLDetailsElement>("[data-project-menu]");
  if (menu !== null) {
    const panel = menu.querySelector<HTMLElement>("[data-menu-panel]");
    menu.addEventListener("toggle", () => {
      if (!menu.open || panel === null) return;
      const below = window.innerHeight - menu.getBoundingClientRect().bottom;
      panel.dataset.drop = below < panel.offsetHeight + 24 ? "up" : "down";
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector<HTMLElement>("summary")?.focus();
      }
    });
    document.addEventListener("pointerdown", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  }

  async function send(url: string, body: Record<string, unknown>): Promise<boolean> {
    const response = await fetch(url, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    });
    return response.ok;
  }

  function bind(selector: string, act: (id: string, button: HTMLButtonElement) => Promise<boolean>) {
    document.querySelectorAll<HTMLButtonElement>(selector).forEach((button) => {
      button.addEventListener("click", async () => {
        const id = button.dataset.stepMark ?? button.dataset.stepDone
          ?? button.dataset.finish ?? button.dataset.unfinish;
        if (id === undefined) return;
        button.disabled = true;
        if (await act(id, button)) {
          window.location.reload();
          return;
        }
        button.disabled = false;
      });
    });
  }

  // Unmarking sends null, which records nothing: FR-22 makes it a non-event.
  /*
    The entry the owner just wrote belongs in the history beside it, and reloading to show it
    would cost the focus and the two taps `NFR-1` protects. The chart still grows: that is the
    confirmation § Interaction States names, and this only stops the list from lying meanwhile.
  */
  document.addEventListener("ritmo:entry-saved", (event) => {
    const detail = (event as CustomEvent<{ id: string; what: string; minutes: number | null }>).detail;
    const list = document.querySelector<HTMLElement>("[data-history]");
    if (list === null) return;
    document.querySelector<HTMLElement>("[data-history-empty]")?.remove();

    const row = document.createElement("li");
    row.className = "flex items-start gap-3.5 border-b border-hair py-3 last:border-b-0";
    const day = document.createElement("span");
    day.className = "shrink-0 pt-0.5 font-mono text-[12px] whitespace-nowrap text-dim";
    day.textContent = new Date().toLocaleDateString("es", { day: "2-digit", month: "short" });
    const mark = document.createElement("span");
    mark.className = "mt-1.5 w-3 shrink-0";
    mark.setAttribute("aria-hidden", "true");
    const what = document.createElement("span");
    what.className = "grow text-sm leading-[1.45] text-ink md:text-[15px]";
    what.textContent = detail.what;
    row.append(day, mark, what);
    if (detail.minutes !== null) {
      const minutes = document.createElement("span");
      minutes.className = "shrink-0 pt-0.5 font-mono text-[12px] text-dim";
      minutes.textContent = `${detail.minutes} min`;
      row.append(minutes);
    }
    list.prepend(row);
  });

  bind("[data-step-mark]", (id, button) =>
    send("/api/steps", { id, markedFor: button.dataset.stepMarked === "true" ? null : today }));
  bind("[data-step-done]", (id) => send("/api/steps", { id, done: true }));
  bind("[data-finish]", (id) => send("/api/projects", { id, finished: true }));


  bind("[data-unfinish]", (id) => send("/api/projects", { id, finished: false }));

  document.querySelectorAll<HTMLFormElement>("[data-step-form]").forEach((form) => {
    bindFieldErrorClearing(form);
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const projectId = form.elements.namedItem("projectId");
      const title = form.elements.namedItem("title");
      const estimate = form.elements.namedItem("estimateMinutes");
      const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
      const status = form.querySelector<HTMLElement>("[data-step-status]");
      if (
        !(projectId instanceof HTMLInputElement) ||
        !(title instanceof HTMLInputElement) ||
        !(estimate instanceof HTMLInputElement)
      ) return;

      const issue = firstFieldIssue([
        { name: "title", value: title.value, requiredMessage: "Escribe el paso." },
        {
          name: "estimateMinutes",
          value: estimate.value,
          positiveIntegerMessage: "Escribe minutos enteros mayores que cero.",
        },
      ]);
      if (issue !== null) {
        showFieldIssue(form, issue);
        setFormStatus(status, "", "idle");
        return;
      }
      clearFieldErrors(form);
      if (button !== null) button.disabled = true;
      setFormStatus(status, "Guardando…", "loading");
      try {
        const body: Record<string, string | number> = {
          projectId: projectId.value,
          title: title.value,
        };
        if (estimate.value !== "") body.estimateMinutes = Number(estimate.value);
        const response = await fetch("/api/steps", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const result: unknown = await response.json();
        if (!response.ok) {
          const serverIssue = fieldIssueFromServer(readError(result), fieldNames(form));
          if (serverIssue !== null) {
            showFieldIssue(form, serverIssue);
            setFormStatus(status, "", "idle");
          } else {
            setFormStatus(status, "No se pudo guardar el paso. Recarga la página e inténtalo otra vez.", "error");
          }
          return;
        }
        setFormStatus(status, "Paso guardado.", "success");
        window.setTimeout(() => window.location.reload(), 500);
      } catch {
        setFormStatus(status, "No se pudo conectar. Revisa la conexión e inténtalo otra vez.", "error");
      } finally {
        if (button !== null) button.disabled = false;
      }
    });
  });

  function readError(body: unknown): string {
    return typeof body === "object" && body !== null && "error" in body && typeof body.error === "string"
      ? body.error
      : "No se pudo guardar el paso";
  }
</script>
