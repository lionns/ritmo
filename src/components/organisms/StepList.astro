---
import type { PortfolioProject } from "../../../contracts/portfolio.ts";
import StepFields from "../molecules/StepFields.astro";
import { readAsSentence } from "../../lib/project-row.ts";

interface Props {
  project: PortfolioProject;
  today: string;
}

const { project, today } = Astro.props;
const formPrefix = `step-${project.id}`;
// The summary carries no number: collapsed, the landing surface shows nothing of the list
// (D-024's third guardrail, design-handoff.md § The Project Row).
const summary = project.openSteps.length === 0
  ? "Escribir los próximos pasos"
  : "Elegir lo de hoy";
---

<details class="border-t border-hair" data-step-list>
  <summary class="flex min-h-[58px] cursor-pointer list-none items-center justify-between gap-4 py-3 text-sm font-medium text-dim marker:content-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14">
    <span>{summary}</span>
    <span class="font-mono text-[13px] text-faint-text" data-disclosure-marker aria-hidden="true">+</span>
  </summary>

  {project.openSteps.length > 0 && (
    <ul class="m-0 list-none p-0 pb-1">
      {project.openSteps.map((step) => (
        <li class="flex items-baseline justify-between gap-3 border-b border-hair py-2.5 last:border-b-0">
          <span class="text-sm leading-[1.45] text-dim md:text-[15px]">{readAsSentence(step)}</span>
          <span class="flex shrink-0 items-center gap-2">
            <button
              class="min-h-[34px] rounded-full border border-glass-border px-3 text-[13px] font-medium text-dim transition-[color,border-color] duration-[120ms] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              type="button"
              data-step-mark={step.id}
              data-step-marked={step.markedFor === today ? "true" : "false"}
            >
              {step.markedFor === today ? "Quitar de hoy" : "Hoy"}
            </button>
            <button
              class="min-h-[34px] rounded-full border border-glass-border px-3 text-[13px] font-medium text-dim transition-[color,border-color] duration-[120ms] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              type="button"
              data-step-done={step.id}
            >
              Hecho
            </button>
          </span>
        </li>
      ))}
    </ul>
  )}

  <form class="pt-3 pb-5" data-step-form novalidate>
    <input type="hidden" name="projectId" value={project.id} />
    <StepFields idPrefix={formPrefix} />
    <button class="mt-5 inline-flex min-h-[58px] w-full items-center justify-center rounded-[29px] border-0 bg-accent px-7 text-[17px] font-semibold text-accent-ink transition-[filter] duration-[120ms] hover:brightness-[1.06] active:brightness-90 disabled:cursor-wait disabled:saturate-[0.35] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14 md:rounded-[28px] md:text-base" type="submit">
      Guardar paso
    </button>
    <p class="mt-3 min-h-[42px] text-sm leading-normal text-dim" data-step-status data-form-status aria-live="polite"></p>
  </form>
</details>

<script define:vars={{ today }}>
  window.__ritmoToday = today;
</script>
<script>
  import {
    bindFieldErrorClearing,
    clearFieldErrors,
    fieldIssueFromServer,
    fieldNames,
    firstFieldIssue,
    setFormStatus,
    showFieldIssue,
  } from "../../lib/form-errors.ts";

  const today = (window as unknown as { __ritmoToday: string }).__ritmoToday;

  async function patchStep(body: Record<string, unknown>): Promise<boolean> {
    const response = await fetch("/api/steps", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    });
    return response.ok;
  }

  document.querySelectorAll<HTMLButtonElement>("[data-step-mark]").forEach((button) => {
    button.addEventListener("click", async () => {
      const id = button.dataset.stepMark;
      if (id === undefined) return;
      button.disabled = true;
      // Unmarking sends null, which records nothing: FR-22 makes it a non-event.
      const marked = button.dataset.stepMarked === "true";
      if (await patchStep({ id, markedFor: marked ? null : today })) {
        window.location.reload();
        return;
      }
      button.disabled = false;
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-step-done]").forEach((button) => {
    button.addEventListener("click", async () => {
      const id = button.dataset.stepDone;
      if (id === undefined) return;
      button.disabled = true;
      if (await patchStep({ id, done: true })) {
        window.location.reload();
        return;
      }
      button.disabled = false;
    });
  });

  document.querySelectorAll<HTMLFormElement>("[data-step-form]").forEach((form) => {
    bindFieldErrorClearing(form);
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const projectId = form.elements.namedItem("projectId");
      const title = form.elements.namedItem("title");
      const estimate = form.elements.namedItem("estimateMinutes");
      const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
      const status = form.querySelector<HTMLElement>("[data-step-status]");
      if (
        !(projectId instanceof HTMLInputElement) ||
        !(title instanceof HTMLInputElement) ||
        !(estimate instanceof HTMLInputElement)
      ) return;

      const issue = firstFieldIssue([
        { name: "title", value: title.value, requiredMessage: "Escribe el paso." },
        {
          name: "estimateMinutes",
          value: estimate.value,
          positiveIntegerMessage: "Escribe minutos enteros mayores que cero.",
        },
      ]);
      if (issue !== null) {
        showFieldIssue(form, issue);
        setFormStatus(status, "", "idle");
        return;
      }
      clearFieldErrors(form);
      if (button !== null) button.disabled = true;
      setFormStatus(status, "Guardando…", "loading");
      try {
        const body: Record<string, string | number> = {
          projectId: projectId.value,
          title: title.value,
        };
        if (estimate.value !== "") body.estimateMinutes = Number(estimate.value);
        const response = await fetch("/api/steps", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const result: unknown = await response.json();
        if (!response.ok) {
          const serverIssue = fieldIssueFromServer(readError(result), fieldNames(form));
          if (serverIssue !== null) {
            showFieldIssue(form, serverIssue);
            setFormStatus(status, "", "idle");
          } else {
            setFormStatus(status, "No se pudo guardar el paso. Recarga la página e inténtalo otra vez.", "error");
          }
          return;
        }
        setFormStatus(status, "Paso guardado.", "success");
        window.setTimeout(() => window.location.reload(), 500);
      } catch {
        setFormStatus(status, "No se pudo conectar. Revisa la conexión e inténtalo otra vez.", "error");
      } finally {
        if (button !== null) button.disabled = false;
      }
    });
  });

  function readError(body: unknown): string {
    return typeof body === "object" && body !== null && "error" in body && typeof body.error === "string"
      ? body.error
      : "No se pudo guardar el paso";
  }
</script>
