---
import type { CaptureErrorResponse, SettingsResponse } from "../../contracts/capture.ts";
import HeroChart from "../components/molecules/HeroChart.astro";
import PageStage from "../components/organisms/PageStage.astro";
import SettingsPanel from "../components/organisms/SettingsPanel.astro";
import AuthPanel from "../components/organisms/AuthPanel.astro";
import AppShell from "../layouts/AppShell.astro";

Astro.response.headers.set("Cache-Control", "no-store");

let settings: SettingsResponse | null = null;
let loadError: string | null = null;
try {
  const response = await fetch(new URL("/api/settings", Astro.url), { redirect: "manual", headers: { Accept: "application/json", Cookie: Astro.request.headers.get("cookie") ?? "" } });
  const body = await response.json() as SettingsResponse | CaptureErrorResponse;
  if (!response.ok || "error" in body) loadError = response.status === 409 ? "Responde primero la pregunta de la semana mala." : "No se pudieron leer los ajustes.";
  else settings = body;
} catch {
  loadError = "No se pudieron leer los ajustes. Revisa la conexión y recarga.";
}
---

<AppShell title="Ajustes · Ritmo" description="Las áreas, los proyectos y su límite activo." context="Ajustes" pageScroll>
  <div class="pointer-events-none fixed inset-0 -z-10 bg-[color-mix(in_srgb,var(--page-bg)_80%,transparent)]" aria-hidden="true"></div>
  <PageStage chartVeiled boundedPanels={false} fullWidth>
    <section class="xl:col-span-2" aria-labelledby="page-title">
      <h1 id="page-title" class="text-[17px] leading-[1.15] font-semibold tracking-[-0.02em] text-ink md:text-xl">La estructura.</h1>
      <p class="mt-3 max-w-[620px] text-[15px] leading-[1.55] text-dim">Las áreas que ordenan el portfolio y los proyectos que usan su límite.</p>
      <a class="mt-3 inline-flex min-h-[58px] items-center text-sm font-medium text-dim underline-offset-[5px] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14" href="/">Volver al portfolio</a>
    </section>
    {settings === null ? (
      <section class="glass-panel p-6" aria-live="polite">
        <p class="text-sm leading-normal text-dim">{loadError}</p>
        <a class="mt-3 inline-flex min-h-[58px] items-center text-sm font-medium text-ink underline-offset-4 md:min-h-14" href="/">Ir al inicio</a>
      </section>
    ) : <SettingsPanel settings={settings} />}
    <section class="glass-panel p-[22px] md:p-7 xl:col-span-2" aria-labelledby="export-heading">
      <h2 id="export-heading" class="text-base font-semibold text-ink">Tu copia completa</h2>
      <p class="mt-3 max-w-[620px] text-sm leading-normal text-dim">Descarga tu registro completo en un archivo SQLite. Puedes abrirlo sin Ritmo. Incluye todos tus datos y las credenciales públicas de tus llaves de acceso, sin cifrar. No incluye la contraseña de respaldo ni su hash, que viven en la configuración del servidor.</p>
      <a href="/api/export" download class="mt-5 inline-flex min-h-[58px] items-center justify-center rounded-[29px] border border-glass-border px-6 text-base font-semibold text-ink hover:brightness-[1.06] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:min-h-14">Descargar copia completa</a>
    </section>
    <AuthPanel settings />
    <HeroChart slot="chart" entries={[]} />
  </PageStage>
</AppShell>
