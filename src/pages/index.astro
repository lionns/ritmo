---
import type {
  PortfolioErrorResponse,
  PortfolioResponse,
} from "../../contracts/portfolio.ts";
import HeroChart from "../components/molecules/HeroChart.astro";
import PortfolioPanel from "../components/organisms/PortfolioPanel.astro";
import AppShell from "../layouts/AppShell.astro";

Astro.response.headers.set("Cache-Control", "no-store");

let portfolio: PortfolioResponse | null = null;
let loadError: string | null = null;
try {
  const response = await fetch(new URL("/api/portfolio", Astro.url), {
    headers: { Accept: "application/json" },
  });
  const body = await response.json() as PortfolioResponse | PortfolioErrorResponse;
  if (!response.ok || "error" in body) loadError = "No se pudo leer el portfolio. Recarga para intentarlo otra vez.";
  else portfolio = body;
} catch {
  loadError = "No se pudo leer el portfolio. Revisa la conexión y recarga.";
}

const projects = portfolio === null ? [] : [...portfolio.progress, ...portfolio.outstanding];
const entries = projects.flatMap(({ recentEntries }) => recentEntries);
---

<AppShell title="Ritmo · Tu portfolio" description="Lo que moviste y lo que puede esperar.">
  <div class="hero-stage">
    <HeroChart entries={entries} />
  </div>
  <main class="page-grid">
    <section class="portfolio-intro" aria-labelledby="page-title">
      <p class="mono-label">Portfolio · últimos 28 días</p>
      <h1 id="page-title" class="display-title">Lo que moviste.</h1>
      <p class="intro-copy">
        Primero lo que tuvo movimiento. Después, lo que puede esperar sin convertirse en presión.
      </p>
      <a class="primary-action" href="/registrar">Registrar una línea</a>
    </section>
    {
      portfolio === null ? (
        <section class="portfolio-panel glass-panel" aria-live="polite">
          <p class="load-error">{loadError}</p>
          <a class="text-link" href="/">Recargar</a>
        </section>
      ) : (
        <PortfolioPanel progress={portfolio.progress} outstanding={portfolio.outstanding} />
      )
    }
  </main>
</AppShell>

<style>
  .portfolio-panel {
    padding: 24px;
  }
</style>
