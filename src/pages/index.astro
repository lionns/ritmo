---
import type {
  PortfolioErrorResponse,
  PortfolioResponse,
} from "../../contracts/portfolio.ts";
import HeroChart from "../components/molecules/HeroChart.astro";
import PageStage from "../components/organisms/PageStage.astro";
import PortfolioPanel from "../components/organisms/PortfolioPanel.astro";
import SetupForm from "../components/organisms/SetupForm.astro";
import AppShell from "../layouts/AppShell.astro";

Astro.response.headers.set("Cache-Control", "no-store");

let portfolio: PortfolioResponse | null = null;
let loadError: string | null = null;
try {
  const response = await fetch(new URL("/api/portfolio", Astro.url), {
    headers: { Accept: "application/json" },
  });
  const body = await response.json() as PortfolioResponse | PortfolioErrorResponse;
  if (!response.ok || "error" in body) loadError = "No se pudo leer el portfolio. Recarga para intentarlo otra vez.";
  else portfolio = body;
} catch {
  loadError = "No se pudo leer el portfolio. Revisa la conexión y recarga.";
}

const readyPortfolio = portfolio !== null && !portfolio.setupRequired ? portfolio : null;
const projects = readyPortfolio === null ? [] : [
  ...readyPortfolio.progress,
  ...readyPortfolio.outstanding,
  ...readyPortfolio.shelved,
];
const entries = projects.flatMap(({ recentEntries }) => recentEntries);
const setupRequired = portfolio?.setupRequired === true;
---

<AppShell
  title="Ritmo · Tu portfolio"
  description="Lo que moviste y lo que puede esperar."
  context={setupRequired ? "Primera vez" : portfolio === null ? "Portfolio" : "14 días · minutos"}
  contextWide={setupRequired ? "Primera vez" : portfolio === null ? "Portfolio" : "28 días · altura = minutos registrados"}
>
  <PageStage chartVeiled={setupRequired}>
    <section class="self-center" aria-labelledby="page-title">
      <h1 id="page-title" class="max-w-[760px] font-display text-[clamp(46px,13.2vw,64px)] leading-[0.84] font-semibold tracking-[-0.04em] md:text-[clamp(76px,9.2vw,132px)]">
        {setupRequired ? "En una semana mala, ¿cuántos proyectos puedes tocar de verdad?" : "Lo que moviste."}
      </h1>
      <p class="mt-6 max-w-[470px] text-[15px] leading-[1.55] text-dim">
        {setupRequired
          ? "La respuesta fija el límite de las áreas que compiten por tu capacidad."
          : "Primero lo que tuvo movimiento. Después, lo que puede esperar sin convertirse en presión."}
      </p>
      {readyPortfolio !== null && (
        <a
          class="mt-[30px] inline-flex min-h-[58px] w-full items-center justify-center rounded-[29px] bg-accent px-7 text-[17px] font-semibold text-accent-ink no-underline transition-[filter] duration-[120ms] hover:brightness-[1.06] active:brightness-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none md:min-h-14 md:w-auto md:min-w-[218px] md:rounded-[28px] md:text-base"
          href={projects.some(({ state }) => state === "active") ? "/registrar" : "#nuevo-proyecto"}
        >{projects.some(({ state }) => state === "active") ? "Registrar una línea" : "Crear un proyecto"}</a>
      )}
    </section>
    {
      portfolio === null ? (
        <section class="glass-panel p-6" aria-live="polite">
          <p class="text-sm leading-normal text-dim">{loadError}</p>
          <a
            class="inline-flex min-h-[58px] items-center text-sm font-medium text-dim underline-offset-[5px] transition-colors duration-[120ms] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none md:min-h-14"
            href="/">Recargar</a
          >
        </section>
      ) : portfolio.setupRequired ? (
        <SetupForm />
      ) : (
        <PortfolioPanel
          progress={portfolio.progress}
          outstanding={portfolio.outstanding}
          shelved={portfolio.shelved}
          areas={portfolio.areas}
          activeCount={portfolio.activeCount}
          activeCap={portfolio.activeCap}
        />
      )
    }
    <HeroChart slot="chart" entries={entries} />
  </PageStage>
</AppShell>
