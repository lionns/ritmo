---
import type { ArchiveErrorResponse, ArchiveResponse } from "../../contracts/archive.ts";
import PageStage from "../components/organisms/PageStage.astro";
import AppShell from "../layouts/AppShell.astro";

Astro.response.headers.set("Cache-Control", "no-store");

let archive: ArchiveResponse | null = null;
let loadError: string | null = null;
try {
  const response = await fetch(new URL("/api/archive", Astro.url), {
    redirect: "manual", headers: { Accept: "application/json", Cookie: Astro.request.headers.get("cookie") ?? "" },
  });
  const body = await response.json() as ArchiveResponse | ArchiveErrorResponse;
  if (!response.ok || "error" in body) loadError = "No se pudo leer el archivo. Recarga para intentarlo otra vez.";
  else archive = body;
} catch {
  loadError = "No se pudo leer el archivo. Revisa la conexión y recarga.";
}

const finished = archive?.finished ?? [];
const shelved = archive?.shelved ?? [];
const isEmpty = finished.length === 0 && shelved.length === 0;
// D-025 and brief.md § Constraints: no count of either group, nothing red, nothing congratulated.
// The headings name what is there; a number beside them would make this a ledger of what is left.
const dayOf = (moment: string) => moment.slice(0, 10);
---

<AppShell title="Archivo · Ritmo" description="Lo terminado y lo archivado." context="Archivo">
  <div class="pointer-events-none fixed inset-0 -z-10 bg-[color-mix(in_srgb,var(--page-bg)_80%,transparent)]" aria-hidden="true"></div>
  <PageStage chartVeiled>
    <section class="self-center" aria-labelledby="page-title">
      <h1 id="page-title" class="max-w-[760px] font-display text-[clamp(46px,13.2vw,64px)] leading-[0.84] font-semibold tracking-[-0.04em] md:text-[clamp(76px,9.2vw,132px)]">Lo que ya no está.</h1>
      <p class="mt-6 max-w-[470px] text-[15px] leading-[1.55] text-dim">Terminado o guardado para después. Nada de esto se borró.</p>
      <a
        class="mt-3 inline-flex min-h-[58px] w-fit items-center text-sm font-medium text-dim underline-offset-[5px] transition-colors duration-[120ms] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none md:min-h-14"
        href="/">Volver al portfolio</a
      >
    </section>

    <section class="glass-panel p-[22px] md:px-7 md:py-6" aria-labelledby="archive-heading">
      <h2 id="archive-heading" class="m-0 font-mono text-[8px] leading-[1.4] font-normal tracking-[0.22em] text-dim uppercase md:text-[9px]">Terminados</h2>
      {
        loadError !== null ? (
          <p class="mt-5 mb-1 text-sm leading-normal text-dim" aria-live="polite">{loadError}</p>
        ) : isEmpty ? (
          <p class="mt-5 mb-1 text-sm leading-normal text-dim">
            Aún no has terminado ni archivado nada. Cuando lo hagas, vive aquí.
          </p>
        ) : (
          <>
            {finished.length === 0 ? (
              <p class="mt-5 mb-1 text-sm leading-normal text-dim">Todavía nada terminado.</p>
            ) : (
              <ul class="m-0 mt-4 list-none p-0">
                {finished.map((project) => (
                  <li class="flex items-baseline justify-between gap-4 border-b border-hair py-3.5 last:border-b-0">
                    <span>
                      <span class="block text-[17px] leading-[1.15] font-semibold tracking-[-0.02em] text-ink md:text-xl">{project.title}</span>
                      <span class="mt-1.5 block text-sm leading-[1.45] text-dim md:text-[15px]">
                        {project.areaName} · Terminado el {dayOf(project.finishedAt ?? "")}
                      </span>
                    </span>
                    <button
                      class="min-h-[34px] shrink-0 rounded-full border border-glass-border px-3 text-[13px] font-medium text-dim transition-[color,border-color] duration-[120ms] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                      type="button"
                      data-unfinish={project.id}
                    >
                      Deshacer
                    </button>
                  </li>
                ))}
              </ul>
            )}

            <h2 class="mt-8 font-mono text-[8px] leading-[1.4] font-normal tracking-[0.22em] text-dim uppercase md:text-[9px]">Archivados</h2>
            {shelved.length === 0 ? (
              <p class="mt-4 mb-1 text-sm leading-normal text-dim">Nada archivado.</p>
            ) : (
              <ul class="m-0 mt-4 list-none p-0">
                {shelved.map((project) => (
                  <li class="border-b border-hair py-3.5 last:border-b-0">
                    <span class="block text-[17px] leading-[1.15] font-semibold tracking-[-0.02em] text-ink md:text-xl">{project.title}</span>
                    <span class="mt-1.5 block text-sm leading-[1.45] text-dim md:text-[15px]">{project.areaName} · sigue en el portafolio</span>
                  </li>
                ))}
              </ul>
            )}
          </>
        )
      }
    </section>
  </PageStage>
</AppShell>

<script>
  // The same call `FinishedRow` makes. After its week a finished project is gone from `/`, so
  // this is the only place left to reopen one — D-025 requires undo to stay reachable.
  document.querySelectorAll<HTMLButtonElement>("[data-unfinish]").forEach((button) => {
    button.addEventListener("click", async () => {
      const id = button.dataset.unfinish;
      if (id === undefined) return;
      button.disabled = true;
      const response = await fetch("/api/projects", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id, finished: false }),
      });
      if (response.ok) {
        window.location.reload();
        return;
      }
      button.disabled = false;
    });
  });
</script>
