---
import type {
  PortfolioErrorResponse,
  PortfolioResponse,
} from "../../contracts/portfolio.ts";
import HeroChart from "../components/molecules/HeroChart.astro";
import EntryForm from "../components/organisms/EntryForm.astro";
import PageStage from "../components/organisms/PageStage.astro";
import AppShell from "../layouts/AppShell.astro";

Astro.response.headers.set("Cache-Control", "no-store");

let portfolio: PortfolioResponse | null = null;
let loadError: string | null = null;
try {
  const response = await fetch(new URL("/api/portfolio", Astro.url), {
    headers: { Accept: "application/json" },
  });
  const body = await response.json() as PortfolioResponse | PortfolioErrorResponse;
  if (!response.ok || "error" in body) loadError = "No se pudieron cargar los proyectos. Recarga para intentarlo otra vez.";
  else portfolio = body;
} catch {
  loadError = "No se pudieron cargar los proyectos. Revisa la conexión y recarga.";
}

const readyPortfolio = portfolio !== null && !portfolio.setupRequired ? portfolio : null;
if (portfolio?.setupRequired) loadError = "Responde primero la pregunta de la semana mala.";
const projects = readyPortfolio === null ? [] : [...readyPortfolio.progress, ...readyPortfolio.outstanding];
const entries = projects.flatMap(({ recentEntries }) => recentEntries);
const selectedProjectId = Astro.url.searchParams.get("project") ?? undefined;
const selectedProject = projects.find(({ id }) => id === selectedProjectId);
---

<AppShell title="Registrar · Ritmo" description="Escribe una línea sobre lo que moviste." context="Registro">
  <div class="pointer-events-none fixed inset-0 -z-10 bg-[color-mix(in_srgb,var(--page-bg)_80%,transparent)]" aria-hidden="true"></div>
  <PageStage chartVeiled>
    <section class="self-center" aria-labelledby="page-title">
      <h1 id="page-title" class="max-w-[760px] font-display text-[clamp(46px,13.2vw,64px)] leading-[0.84] font-semibold tracking-[-0.04em] md:text-[clamp(76px,9.2vw,132px)]">¿Qué moviste?</h1>
      <p class="mt-6 max-w-[470px] text-[15px] leading-[1.55] text-dim">Una línea basta. Los minutos pueden quedarse sin escribir.</p>
      <a
        class="mt-3 inline-flex min-h-[58px] w-fit items-center text-sm font-medium text-dim underline-offset-[5px] transition-colors duration-[120ms] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none md:min-h-14"
        href="/">Volver al portfolio</a
      >
    </section>
    {
      readyPortfolio === null ? (
        <section class="glass-panel p-6" aria-live="polite">
          <p class="text-sm leading-normal text-dim">{loadError}</p>
          <a
            class="inline-flex min-h-[58px] items-center text-sm font-medium text-dim underline-offset-[5px] transition-colors duration-[120ms] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none md:min-h-14"
            href="/">Ir al inicio</a
          >
        </section>
      ) : (
        <EntryForm projects={projects} selectedProject={selectedProject} />
      )
    }
    <HeroChart slot="chart" entries={entries} />
  </PageStage>
</AppShell>
