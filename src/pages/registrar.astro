---
import type {
  PortfolioErrorResponse,
  PortfolioResponse,
} from "../../contracts/portfolio.ts";
import HeroChart from "../components/molecules/HeroChart.astro";
import EntryForm from "../components/organisms/EntryForm.astro";
import AppShell from "../layouts/AppShell.astro";

Astro.response.headers.set("Cache-Control", "no-store");

let portfolio: PortfolioResponse | null = null;
let loadError: string | null = null;
try {
  const response = await fetch(new URL("/api/portfolio", Astro.url), {
    headers: { Accept: "application/json" },
  });
  const body = await response.json() as PortfolioResponse | PortfolioErrorResponse;
  if (!response.ok || "error" in body) loadError = "No se pudieron cargar los proyectos. Recarga para intentarlo otra vez.";
  else portfolio = body;
} catch {
  loadError = "No se pudieron cargar los proyectos. Revisa la conexión y recarga.";
}

const projects = portfolio === null ? [] : [...portfolio.progress, ...portfolio.outstanding];
const entries = projects.flatMap(({ recentEntries }) => recentEntries);
const selectedProjectId = Astro.url.searchParams.get("project") ?? undefined;
---

<AppShell title="Registrar · Ritmo" description="Escribe una línea sobre lo que moviste.">
  <div class="hero-stage">
    <HeroChart entries={entries} />
  </div>
  <div class="hero-veil" aria-hidden="true"></div>
  <main class="page-grid entry-page">
    <section class="portfolio-intro" aria-labelledby="page-title">
      <p class="mono-label">Registrar</p>
      <h1 id="page-title" class="display-title">¿Qué moviste?</h1>
      <p class="intro-copy">Una línea basta. Los minutos pueden quedarse sin escribir.</p>
      <a class="text-link" href="/">Volver al portfolio</a>
    </section>
    {
      portfolio === null ? (
        <section class="entry-fallback glass-panel" aria-live="polite">
          <p class="load-error">{loadError}</p>
          <a class="text-link" href="/registrar">Recargar</a>
        </section>
      ) : (
        <EntryForm projects={projects} selectedProjectId={selectedProjectId} />
      )
    }
  </main>
</AppShell>

<style>
  .entry-page {
    align-items: center;
  }

  .portfolio-intro .text-link {
    width: fit-content;
    margin-top: 12px;
  }

  .entry-fallback {
    padding: 24px;
  }
</style>
