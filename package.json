{
  "name": "ritmo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "test": "node --test test/core/*.test.ts",
    "check:core": "node scripts/check-core-isolation.mjs",
    "types": "WRANGLER_WRITE_LOGS=false wrangler types",
    "pretypecheck": "npm run types",
    "typecheck": "WRANGLER_WRITE_LOGS=false astro check && tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "build": "WRANGLER_WRITE_LOGS=false astro build",
    "test:integration": "WRANGLER_WRITE_LOGS=false vitest run --config vitest.config.ts",
    "db:reset": "node -e \"require('node:fs').rmSync('.wrangler/state/v3/d1', { recursive: true, force: true })\" && WRANGLER_WRITE_LOGS=false wrangler d1 migrations apply ritmo --local",
    "seed": "node scripts/seed-local.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.5",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.9",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
